// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//---------------------ENUMS------------------------------
enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

//---------------------USER---------------------------------------------
model User {
  id             String  @id @default(cuid())
  email          String  @unique
  fullName       String? @map("full_name")
  hashedPassword String? @map("hashed_password")
  role           Role    @default(USER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  cart    Cart?
  address Address?
  orders  Order[]

  @@map("users")
}

//---------------------PRODUCT AND VARIANTS------------------------------
model Product {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  description String? @db.Text
  basePrice   Decimal @map("base_price") @db.Decimal(10, 2) // Avoiding the floating point error
  isPublished Boolean @default(false) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  colors   ProductColor[]

  @@map("products")
}

model ProductColor {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  name      String //BLACK, WHITE
  hexCode   String   @map("hex_code")
  images    String[]

  variants ProductVariant[]
  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@map("product_colors")
}

model ProductVariant {
  id        String @id @default(uuid())
  colorId   String @map("color_id")
  size      String @default("M") // eg S, M, L, XL
  sku       String @unique //Stock Keeping Unit
  stock     Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  productColor ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@unique([colorId, size])
  @@map("product_variants")
}

//---------------------CART AND CART ITEMS---------------------------------
model Cart {
  id     String @id @default(uuid())
  userId String @unique @map("user_id") //FK

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  cartItems CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String  @map("cart_id")
  variantId String  @map("variant_id")
  quantity  Int     @default(1)
  designUrl String? @map("design_url") // stores the design image url

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  //Relations
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

//---------------------ORDER AND ORDER ITEM------------------------------
model Order {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  orderStatus OrderStatus @default(PENDING)
  totalAmount Decimal     @map("total_amount") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  //Relations
  orderItems      OrderItem[]
  payments        Payment[]
  user            User             @relation(fields: [userId], references: [id])
  shippingAddress ShippingAddress?

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  variantId   String  @map("variant_id")
  quantity    Int     @default(1)
  designUrl   String? @map("custom_design_url") // Artwork snapshot
  title       String
  description String  @db.Text
  price       Decimal @db.Decimal(10, 2) // Price snapshot at time of checkout
  size        String  @default("M") // eg S, M, L, XL
  sku         String //Stock Keeping Unit
  color       String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  //Relations
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

//Snapshot of the Address when an order is placed
model ShippingAddress {
  id          String @id @default(uuid())
  orderId     String @unique @map("order_id")
  fullName    String @map("full_name")
  phone       String
  city        String
  landmark    String
  description String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  //Relation
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipping_address")
}

//------------------------PAYMENT AND ADDRESS------------------------------
model Payment {
  id                    String        @id @default(uuid())
  orderId               String        @map("order_id")
  provider              String
  providerTransactionId String?       @unique @map("provider_transaction_id")
  amount                Decimal       @db.Decimal(10, 2)
  method                String
  paymentStatus         PaymentStatus @default(PENDING) @map("payment_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  //Relations
  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Address {
  id          String @id @default(uuid())
  userId      String @unique @map("user_id")
  fullName    String @map("full_name")
  phone       String
  city        String
  landmark    String
  description String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  //Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}
